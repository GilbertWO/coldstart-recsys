    {
      "name": "10 Health",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('status is 200', () => pm.response.to.have.status(200));",
              "pm.test('overall status is UP and the database is UP', () => {",
              "  const b = pm.response.json();",
              "  pm.expect(b.status).to.eql('UP');",
              "  pm.expect(b.components.db.status).to.eql('UP');",
              "});"
            ]
          }
        }
      ],
      "request": {
